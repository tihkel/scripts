#!/bin/bash


# --- USAGE ---
declare -A DICT=(
  ["USAGE"]="bash $0 [dir_paths]"
  ["INFO"]="Shows the system used space and for Zone web hosting shows the limit."
)
source <(curl -s vps.tihkel.ee/usage) DICT "$@"


# --- COLORS ---
RED='\033[31m'
YELLOW='\033[33m'
GREEN='\033[32m'
BOLD='\033[1m'
NC='\033[0m'


# --- QUOTA COMMAND CHECK ---
quota_output=$(quota 2>/dev/null)
quota_output_s=$(quota -s 2>/dev/null)
if [ $? -ne 0 ]; then
    echo "WARN: 'quota' command unavailable."
    echo
else
    used_space=$(echo "$quota_output" | awk 'NR==3 {print $2}')
    used_space_with_unit=$(printf "%.2fG" "$(echo "$used_space/1024/1024" | bc -l)")
    space_limit=$(echo "$quota_output" | awk 'NR==3 {print $3}')
    space_limit_s=$(echo "$quota_output_s" | awk 'NR==3 {print $3}')
    space_usage_percent=$(( used_space * 100 / space_limit ))
    if [ "$space_usage_percent" -ge 80 ]; then
        space_usage_percent_color=$RED
    elif [ "$space_usage_percent" -ge 50 ]; then
        space_usage_percent_color=$YELLOW
    else
        space_usage_percent_color=$GREEN
    fi
    echo
    echo -e "${BOLD}Space used:${NC} ${space_usage_percent_color}${used_space_with_unit}${NC} (limit: ${space_limit_s}, $space_usage_percent%)"
    echo
fi


# --- SHOW SPACE USAGE ---
## SPACE USAGE FUNC IN CURRENT DIR
space_usage() {
    du -sh $1* $1.* 2>/dev/null | sort -hr | head -n 10 | awk -v RED="$RED" -v YELLOW="$YELLOW" -v GREEN="$GREEN" -v NC="$NC" '{
        size = $1
        path = ""
        for (i = 2; i <= NF; i++) {
            if (path == "") path = $i
            else path = path " " $i
        }

        # extract numeric value for coloring (convert suffix-aware)
        num = size
        gsub(/[A-Za-z]/, "", num)
        unit = size
        gsub(/[0-9.]/, "", unit)

        # basic scaling logic
        if (unit == "G" || unit == "T") color = RED
        else if (unit == "M") color = YELLOW
        else color = GREEN

        printf "%s%7s%s %s\n", color, size, NC, path
    }'
    echo "$(du -sh $1 2>/dev/null | awk '{printf "%7s %s\n", $1, $2}')"
#    echo "Total: $(du -sh $1 2>/dev/null | awk '{printf $1}')"
    echo
}


## USAGE for ./domeenid
if [ -d "./domeenid" ] && ! [ $# -gt 0 ]; then
    WWWDOMAIN="$(ls ./domeenid | head -n 1)"
    WWWDOMAIN_PATH="./domeenid/$WWWDOMAIN/"
    echo -e "${BOLD}$WWWDOMAIN_PATH${NC}"
    space_usage $WWWDOMAIN_PATH
fi

## USAGE FOR CURRENT/SET PATH
if [ $# -gt 0 ]; then
    for set_path in "$@"; do
        [[ "$set_path" != /* && "$set_path" != ./* ]] && set_path="./$set_path"
        [[ "$set_path" != */ ]] && set_path="$set_path/"

        echo -e "${BOLD}$set_path${NC}"
        space_usage "$set_path"
    done
else
    echo -e "${BOLD}./${NC}"
    space_usage ./
fi
