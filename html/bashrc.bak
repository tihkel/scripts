#!/bin/bash


# --- NOT INTERACTIVE SHELL ---
#if [[ $- != *i* ]] ; then
#        return
#fi
case $- in
    *i*) ;;
    *) return 0 ;;
esac


# --- COLORS ---
RED='\e[31m'
PURPLE='\e[35m'
CYAN='\e[36m'
ORANGE='\e[38;5;208m'
BOLD='\e[1m'
NC='\e[0m'
# PS1
MAGENTA_PS1='\[\033[01;35m\]'
PURPLE_PS1='\[\033[01;34m\]'
CYAN_PS1='\[\033[01;36m\]'
GREEN_PS1='\[\e[32m\]'
RED_PS1='\[\e[31m\]'
ORANGE_PS1='\[\e[38;5;208m\]'
NC_PS1='\[\033[00m\]'


# --- EXIT IF -s ---
if [[ " $@ " =~ " -s " ]]; then
    return 0
fi


# --- BASH COMPLETION ---
if ! shopt -oq posix; then
  if [ -f /usr/share/bash-completion/bash_completion ]; then
    . /usr/share/bash-completion/bash_completion
  elif [ -f /etc/bash_completion ]; then
    . /etc/bash_completion
  fi
fi


# --- HISTORY FILE CONF ---
shopt -s histappend
HISTSIZE=1000
HISTFILESIZE=2000
shopt -s checkwinsize
HISTCONTROL=ignoreboth


# --- DIR COLORS ---
if [ -x /usr/bin/dircolors ]; then
    eval "$(dircolors -b)"
    bind "set colored-stats on"
    alias ls="ls --color=auto --group-directories-first"
    alias grep="grep --color=auto"
fi


# --- MODT ---
# FIRMWARE UPDATES
if [ -f /run/motd.d/85-fwupd ]; then
        cat /run/motd.d/85-fwupd
fi
# LOGIN MSG
loginMsg=""
if ! cmp -s <(echo "$loginMsg") /etc/motd; then
    echo "Updating /etc/motd file..."
    echo
    sudo bash -c "echo '$loginMsg' > /etc/motd"
fi
# REMOVE DEFAULT LOGIN MSG
if ! ls /etc/update-motd.d/ >/dev/null; then
    echo "Removing /etc/update-motd.d/ files..."
    echo
    sudo rm -f /etc/update-motd.d/*
fi


# --- PS1 ---
if [[ $(hostname) == "t-lap" ]]; then
    export PS1='\[\e]2;\u@\h: \w\a\]'"\
${MAGENTA_PS1}"'\u'"\
${PURPLE_PS1}"'@'"\
${MAGENTA_PS1}"'\h'"\
${NC_PS1}"':'"\
${PURPLE_PS1}"'\w'"\
${NC_PS1}"'\$ '
elif [[ $(hostname) == "t-k-debian" ]]; then
    export PS1='\[\e]2;\u@\h: \w\a\]'"\
${MAGENTA_PS1}"'\u'"\
${CYAN_PS1}"'@'"\
${MAGENTA_PS1}"'\h'"\
${NC_PS1}"':'"\
${CYAN_PS1}"'\w'"\
${NC_PS1}"'\$ '
elif [[ $(hostname) == "t-vps" ]]; then
    export PS1='\[\e]2;\u@\h: \w\a\]'"\
${MAGENTA_PS1}"'\u'"\
${ORANGE_PS1}"'@'"\
${MAGENTA_PS1}"'\h'"\
${NC_PS1}"':'"\
${ORANGE_PS1}"'\w'"\
${NC_PS1}"'\$ '
else
    export PS1='\[\e]2;\u@\h: \w\a\]'"\
${GREEN_PS1}"'\u'"\
${GREEN_PS1}"'@'"\
${RED_PS1}"'\h'"\
${NC_PS1}"':'"\
${GREEN_PS1}"'\w'"\
${NC_PS1}"'\$ '
fi


# --- HOSTS FILE SETUP ---
hosts="
127.0.0.1	localhost
$([[ $(hostname) == "t-pm" ]] && echo "192.168.1.2" || echo "127.0.0.1")	$(hostname).lan $(hostname)
::1		localhost ip6-localhost ip6-loopback
ff02::1		ip6-allnodes
ff02::2		ip6-allrouters

# MY HOSTS
192.168.1.2 t-pm
192.168.1.3 t-lap
192.168.1.4 t-teler
192.168.1.5 t-k-debian
192.168.1.7 t-pirukas
192.168.1.200 t-v-debian

# VPN
10.182.94.1 t-pirukas.vpn
10.182.94.4 t-pm.vpn
10.182.94.5 t-lap.vpn
10.182.94.6 t-k-debian.vpn
10.182.94.8 t-v-debian.vpn


# ZONE CUSTOM
#217.146.69.x
"
if ! cmp -s <(echo "$hosts") /etc/hosts; then
    echo "Updating /etc/hosts file..."
    echo
    sudo bash -c "cat > /etc/hosts << EOF
$hosts
EOF"
fi


# --- FOR NVIM ---
PROMPT_COMMAND="echo -ne '\e[6 q'"


# --- ALIASES ---
# SSH
alias sshs="ssh tihkel@t-pm.vpn"
alias sshk="ssh tihkel@t-k-debian.vpn"
alias sshp="ssh tihkel@t-pirukas.vpn"
alias sshv="ssh tihkel@t-v-debian.vpn"
alias sshu="ssh debian@vps.tihkel.ee"
alias ssht="ssh virt135310@tihkel.ee"

# SOUND TUNNEL
if command -v pactl >/dev/null 2>&1; then
    # RECEIVER TUNNEL
    alias maket="pactl load-module module-native-protocol-tcp auth-anonymous=1"
    remt() {
        ids=$(pactl list short modules | awk "/module-native-protocol-tcp/ {print \$1}")
        if [ -z "$ids" ]; then
            echo "No receiving tunnels exist"
        else
            for id in $ids; do
                echo "Removing transmiting tunnel id: $id"
                pactl unload-module "$id"
            done
        fi
    }
    # TRANSMITER TUNNEL
    alias addt="pactl load-module module-tunnel-sink server=t-k-debian sink_name=remote latency_msec=130"
    delt() {
        ids=$(pactl list short modules | awk '/module-tunnel-sink/{print $1}')
        if [ -z "$ids" ]; then
            echo "No transmiting tunnels exist"
        else
            for id in $ids; do
                echo "Deleting receiver tunnel id: $id"
                pactl unload-module "$id"
            done
        fi
    }
    # LOCAL TUNNEL
    addtl() {
        modules=$(pactl list short modules | awk '/module-tunnel-sink/ {print $1}')
        if [[ -n "$modules" ]]; then
            pactl load-module module-loopback source=remote.monitor sink=alsa_output.pci-0000_00_1f.3.analog-stereo latency_msec=250
        else
            echo "Create transmitting tunnel first."
        fi
    }
    deltl() {
        ids=$(pactl list short modules | awk '/module-loopback/{print $1}')
        if [ -z "$ids" ]; then
            echo "No local tunnels exist"
        else
            for id in $ids; do
                echo "Deleting local tunnel id: $id"
                pactl unload-module "$id"
            done
        fi
    }
fi

# VPS SCRIPTS
alias ns="bash <(curl -s vps.tihkel.ee/ns)"
alias space="bash <(curl -s vps.tihkel.ee/space)"
alias disk="bash <(curl -s vps.tihkel.ee/disk)"
alias inodes="bash <(curl -s vps.tihkel.ee/inodes)"
alias wp-to-zone.ssh.j="bash <(curl -s vps.tihkel.ee/wp-to-zone.ssh.j)"

# LOCAL SCIPTS
alias ksk="bash ~/scripts/ksk/ksk"
alias kak="bash ~/scripts/ksk/kak"
alias win="bash ~/scripts/win"
alias anime="~/Documents/ani-cli/ani-cli"
alias scrcpy="~/Documents/scrcpy/scrcpy"
alias scrcpyt="adb connect t-teler && ~/Documents/scrcpy/scrcpy"
alias amv="bash ~/scripts/amv https://www.youtube.com/playlist?list=PLPOWv0xMZ4jDnN7DRxLeJRUkKy9TGbeU-"
alias splay="bash ~/scripts/max/s-query"

# OTHER
micrec() {
    # DEAFULTS
    local host=""
    local port=4444
    # SET CASE FOR ARGS
    while [[ $# -gt 0 ]]; do
        case $1 in
            -p)
                shift
                port="$1"
                ;;
            *)
                host="$1"
                ;;
        esac
        shift
    done
    # IF HOST NOT SET
    if [ -z "$host" ]; then
        echo "Error: host not specified"
        return 1
    fi
    # RUN RECORDER
    arecord -f cd | nc "$host" "$port"
}
t-vpn() {
    case "$1" in
        up) sudo wg-quick up t-vpn ;;
        down) sudo wg-quick down t-vpn ;;
    esac
}
lst() {
  local path="."
  local depth="1"

  for arg in "$@"; do
    if [[ "$arg" =~ ^[0-9]+$ ]]; then
      depth="$arg"
    else
      path="$arg"
    fi
  done

  tree --dirsfirst -L "$depth" "$path"
}
hl() {
    sed "s/$1/\x1b[1;31m&\x1b[0m/g"
}
lockin() {
    pactl set-sink-volume @DEFAULT_SINK@ 100%
    playerctl volume 0.8
    catt -d 192.168.1.4 volume 40
    node ~/scripts/tuya-control/remote.js bulb-1 on
    node ~/scripts/tuya-control/remote.js bulb-1 mode scene purplebulb
    node ~/scripts/tuya-control/remote.js bulb-2 on
    node ~/scripts/tuya-control/remote.js bulb-2 mode scene purplebulb
    node ~/scripts/tuya-control/remote.js led on
    node ~/scripts/tuya-control/remote.js led mode scene purpleled
    node ~/scripts/tuya-control/remote.js pluh-1 on
}
chill() {
    pactl set-sink-volume @DEFAULT_SINK@ 100%
    playerctl volume 0.6
    catt -d 192.168.1.4 volume 40
    node ~/scripts/tuya-control/remote.js bulb-1 on
    node ~/scripts/tuya-control/remote.js bulb-1 mode color orangebulb
    node ~/scripts/tuya-control/remote.js bulb-2 on
    node ~/scripts/tuya-control/remote.js bulb-2 mode color orangebulb
    node ~/scripts/tuya-control/remote.js led on
    node ~/scripts/tuya-control/remote.js led mode color orangeled
    node ~/scripts/tuya-control/remote.js pluh-1 on
}

whois_func() {
    command whois "$1" | sed \
    -e "/^%/d" \
    -e "/^#/d" \
    -e "/^TERMS OF USE:/,/^$/d" \
    -e "/^NOTICE:/,/^$/d" \
    -e "/^The data in MarkMonitor’s WHOIS/,/^$/d" \
    -e "/^By submitting a WHOIS query,/,/^$/d" \
    -e "/^If you have a legitimate interest/,/^$/d" \
    -e "/^This listing is a Network Solutions Private Registration./,/^$/d" \
    -e "/^Domain:/s/\(Domain: \)\(\S\+\)/\1\x1b[35m\2\x1b[0m/" \
    -e "s/Registrar:/\x1b[35m&\x1b[0m/g" \
    -e "s/Registrant:/\x1b[35m&\x1b[0m/g" \
    -e "s/Name servers:/\x1b[35m&\x1b[0m/g" \
    -e "/status:/s/status:\(.*\)/\x1b[35mstatus:\x1b[36m\1\x1b[0m/" \
    -e "/Status:/s/Status:\(.*\)/\x1b[35mStatus:\x1b[36m\1\x1b[0m/" \
    -e "s/Not Disclosed/\x1b[31m&\x1b[0m/g" \
    -e "s/NOT DISCLOSED!/\x1b[31m&\x1b[0m/g" \
    -e "/Registrar:/,/^$/s/\(name:\)\(.*\)/\1\x1b[36m\2\x1b[0m/" \
    -e "/Registrar:/,/^$/s/\(Name:\)\(.*\)/\1\x1b[36m\2\x1b[0m/" \
    -e "/Registrant:/,/^$/s/\(name:\)\(.*\)/\1\x1b[36m\2\x1b[0m/" \
    -e "/Domain:/,/^$/s/\(name:\)\(.*\)/\1\x1b[35m\2\x1b[0m/" \
    -e "/^nserver:/s/\(nserver:\)\(.*\)/\1\x1b[36m\2\x1b[0m/" \
    -e "/Name Server:/s/\(Name Server:\)\(.*\)/\1\x1b[36m\2\x1b[0m/" \
    -e "/netname:/s/netname:\(.*\)/\x1b[35mnetname:\x1b[36m\1\x1b[0m/" \
    -e "/Netname:/s/Netname:\(.*\)/\x1b[35mNetname:\x1b[36m\1\x1b[0m/" \
    -e "/NetName:/s/NetName:\(.*\)/\x1b[35mNetName:\x1b[36m\1\x1b[0m/" \
    -e "/OrgName:/s/OrgName:\(.*\)/\x1b[35mOrgName:\x1b[36m\1\x1b[0m/" \
    -e "/OrgTechName:/s/OrgTechName:\(.*\)/\x1b[35mOrgTechName:\x1b[36m\1\x1b[0m/" \
    -e "/Organization:/s/Organization:\(.*\)/\x1b[35mOrganization:\x1b[36m\1\x1b[0m/" \
    -e "/Language:/s/Language:\(.*\)/\x1b[35mLanguage:\x1b[36m\1\x1b[0m/" \
    -e "/country:/s/country:\(.*\)/\x1b[35mcountry:\x1b[36m\1\x1b[0m/" \
    -e "/Country:/s/Country:\(.*\)/\x1b[35mCountry:\x1b[36m\1\x1b[0m/" \
    -e "/role:/s/role:\(.*\)/\x1b[35mrole:\x1b[36m\1\x1b[0m/" \
    -e "s/^\(.*\)$/\x1b[32m\1\x1b[0m/" \
    -e "s/\x1b\[35m.*\x1b\[0m/\x1b[0m&\x1b[0m/" \
    -e "s/\x1b\[36m.*\x1b\[0m/\x1b[0m&\x1b[0m/" \
    -e "s/\x1b\[33m.*\x1b\[0m/\x1b[0m&\x1b[0m/"
}
alias whois='whois_func'

alias src="clear && cd && source ~/.bashrc"
alias copy="xclip -selection clipboard"
alias ai="ollama run llama2"
alias speak="espeak-ng -v en-gb-x-rp"
alias search="sudo find / 2>/dev/null | grep"
alias asd="cmatrix -C magenta -u 6"
alias nc-host="nc -lvnp 4444"
alias ..="cd .."
alias cam="cam -c 1 --capture --sdl"
alias update="sudo apt update && sudo apt upgrade"
alias dif="git diff --stat HEAD..origin/main"
alias cattt="catt -d t-teler"
alias adbt="adb connect t-teler"
alias ip="ip -c"
alias mount-nas="sshfs t-pirukas:/mnt/t-nas ~/t-nas"
alias dol="dolphin"
alias tuya="node ~/scripts/tuya-control/remote.js"
alias t-nas-sshfs="sshfs t-pirukas.vpn:/mnt/t-nas ~/t-nas"
alias rnd="openssl rand -base64 12"


# --- NEW SRC ---
# SETTINGS
term_width=$(tput cols)
msg=$(cat << EOF
 Hello $(whoami)! 
EOF
)

# PROCESS EACH LINE
while IFS= read -r line; do
    # CALCULATE
    msg_len=${#line}
    pad_total=$((term_width - msg_len))
    (( pad_total < 0 )) && pad_total=0
    pad_side=$((pad_total / 2))
    left=$(printf '─%.0s' $(seq 1 "$pad_side"))
    right="$left"

    # ADD ONE EXTRA CHAR IF ODD
    if (( (msg_len + 2 * pad_side) < term_width )); then
        right+="─"
    fi

    # ECHO
    echo -e "${BOLD}${left}${line}${right}${NC}"
done <<< "$msg"

c_hostname=$(hostname)
if [ "$c_hostname" = "t-vps" ]; then
    colored_hostname="${ORANGE}$c_hostname${NC}"
elif [ "$c_hostname" = "t-lap" ]; then
    colored_hostname="${PURPLE}$c_hostname${NC}"
elif [ "$c_hostname" = "t-k-debian" ]; then
    colored_hostname="${CYAN}$c_hostname${NC}"
else
    colored_hostname="${RED}${c_hostname}${NC}"
fi
echo -e "  ${BOLD}Hostname:${NC} ${PURPLE}$colored_hostname${NC}"
echo -e "  ${BOLD}Local IPv4:${NC} ${PURPLE}$(hostname -I 2>/dev/null | awk '{print $1}')${NC}"
echo -e "  ${BOLD}Public IPv4:${NC} ${PURPLE}$(dig +short txt ch whoami.cloudflare @1.1.1.1 | tr -d '"')${NC}"
vpn_ip=$(hostname -I | tr ' ' '\n' | grep -E '^10\.' | head -n1)

if [[ -n "$vpn_ip" ]]; then
    echo -e "  ${BOLD}VPN:${NC} ${PURPLE}${vpn_ip}${NC}"
else
    echo -e "  ${BOLD}VPN:${NC} ${RED}Disabled${NC}"
fi
if [ -f /etc/resolv.conf ]; then
    echo -e "  ${BOLD}DNS:${NC} ${PURPLE}$(grep nameserver /etc/resolv.conf | awk '{print $2}' | xargs)${NC}"
else
    echo -e "  ${BOLD}DNS:${NC} ${RED}[ERROR]${NC}"
fi
echo
