#!/bin/bash


# --- USAGE ---
domain="$1"
if [ -z "$domain" ]; then
    echo "Usage: $0 <domain>"
    exit 1
fi
clear


# --- COLORS ---
RED="\e[31m"
GREEN="\e[32m"
PURPLE="\e[35m"
BLUE="\e[36m"
NC="\e[0m"


# --- DOMAIN SCAN ---
echo -e "DNS: ${PURPLE}$domain${NC}"
echo

# NS
echo -e "${PURPLE} NS ${NC}"
echo -e "${PURPLE}────${BLUE}"
dig +short $domain NS
echo

# A
echo -e "${PURPLE} A ${NC}"
echo -e "${PURPLE}───${GREEN}"
ip=$(dig +short "$domain" A)
#ptr=$(host $ip | grep -i "pointer" | awk '{print $5}')
ptr=$(host "$(echo "$ip" | head -n 1)" | grep -i "pointer" | awk '{print $5}')
if [ -n "$ip" ]; then
    sleep 2
#    netname=$(whois "$($ip | head -n 1)" 2>/dev/null | awk 'tolower($1) == "netname:" {print $2; exit}' | tr -d '\r')
    netname=$(whois "$(echo "$ip" | head -n 1)" 2>/dev/null | awk 'tolower($1) == "netname:" {print $2; exit}' | tr -d '\r')
    if [ -z "$netname" ]; then
    netname="Location unknown"
    fi
else
    ip="Missing"
    netname="Location unknown"
fi
echo "$ip ($netname) $ptr"
echo

# MX
echo -e "${PURPLE} MX ${NC}"
echo -e "${PURPLE}────${GREEN}"
dig +short $domain MX
echo

# TXT
echo -e "${PURPLE} TXT ${NC}"
echo -e "${PURPLE}─────${GREEN}"
dig +short $domain TXT
echo

# DKIM
echo -e "${PURPLE} DKIM ${NC}"
echo -e "${PURPLE}──────${NC}"
declare -A DKIM_HOSTS=(
    ["Zone"]="zone._domainkey"
    ["veebimajutuse.ee"]="mail-out._domainkey"
    ["Google"]="google._domainkey"
)
for provider in "${!DKIM_HOSTS[@]}"; do
    selector="${DKIM_HOSTS[$provider]}"
    result=$(dig +short TXT "${selector}.${domain}")
    if [[ -n "$result" ]]; then
        echo -e "${GREEN}$result${NC}"
    fi
done
echo

# DMARC
echo -e "${PURPLE} DMARC ${NC}"
echo -e "${PURPLE}───────${GREEN}"
dig +short TXT _dmarc.$domain
echo

# CMS
echo -e "${PURPLE} CMS ${NC}"
echo -e "${PURPLE}─────${GREEN}"
check_site() {
    local proto=$1
    status_code=$(curl -s --max-time 5 -o /dev/null -w "%{http_code}" "$proto://$domain")
    if [[ "$status_code" =~ ^2|3 ]]; then
        echo "$proto"
    else
        echo ""
    fi
}
protocol=$(check_site http)
if [ -z "$protocol" ]; then
    protocol=$(check_site https)
fi

if [ -z "$protocol" ]; then
    echo -e "${RED}Site down. Last status: $status_code${NC}"
fi
headers=$(curl -sI "$protocol://$domain")
html=$(curl -sL --max-time 5 "$protocol://$domain")
if echo "$html" | grep -qi "wp-content"; then
    echo "WordPress"
elif echo "$html" | grep -qi "Joomla!"; then
    echo "Joomla"
elif echo "$html" | grep -qi "Drupal"; then
    echo "Drupal"
elif echo "$html" | grep -qi "Shopify"; then
    echo "Shopify"
elif echo "$html" | grep -qi "Magento"; then
    echo "Magento"
elif echo "$html" | grep -qi "TYPO3"; then
    echo "TYPO3"
elif echo "$html" | grep -qi "Squarespace"; then
    echo "Squarespace"
elif echo "$html" | grep -qi "Wix.com"; then
    echo "Wix"
elif echo "$html" | grep -qi "Ghost"; then
    echo "Ghost"
else
    echo -e "${RED}Unknown${NC}"
    server=$(echo "$headers" | grep -i "^Server:" | cut -d' ' -f2-)
    if [ -n "$server" ]; then
        echo "Web server: $server"
        if echo "$server" | grep -qi "apache"; then
            echo -e "${GREEN}Apache${NC}"
        elif echo "$server" | grep -qi "nginx"; then
            echo -e "${GREEN}Nginx${NC}"
        fi
    else
        echo -e "${RED}May be using CDN or proxy${NC}"
    fi
fi
echo

# SUBDOMAINS
echo -e "${PURPLE} SUBDOMAINS ${NC}"
echo -e "${PURPLE}────────────${GREEN}"

curl -s "https://crt.sh/?q=%25.$domain&output=json" | \
grep -oP '"name_value":"\K[^"]+' | \
sed 's/\\n/\n/g' | \
sed 's/\*\.//g' | \
sort -u | \
grep "\.$domain$"
echo

# PORTS
echo -e "${PURPLE} PORTS ${NC}"
echo -e "${PURPLE}───────${GREEN}"
#timeout 10 nmap -sV "$domain" -v | grep -oP '\d+(?=/tcp)'
echo -e "${RED}[Turned off.]${NC}"
echo
