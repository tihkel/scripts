#!/usr/bin/env bash

source "$HOME/scripts/.env"

set -euo pipefail

mapfile -t ssh_aliases < <(
    bash -ic 'sshl() { alias | grep "ssh.=" | awk '\''{$1=""; print substr($0,2)}'\''; }; sshl' 2>/dev/null | grep -E "^ssh[^=]*='ssh .+'$"
)

if [[ ${#ssh_aliases[@]} -eq 0 ]]; then
    echo 'No SSH aliases were returned by sshl.' >&2
    exit 1
fi

session="ssh-update-$(date +%Y%m%d-%H%M%S)"

build_pane_cmd() {
    local target=$1
    printf 'trap "exit 130" INT; if ssh -t %q %q; then echo -e %q; for i in 3 2 1; do printf "\\r\\033[KExiting in %%d... " "$i"; sleep 1; done; echo -e "\\r\\033[KExiting now"; else status=$?; if [ "$status" -eq 130 ]; then exit 130; fi; echo -e %q; read -r; fi' "$target" "sudo apt update && sudo apt upgrade && rm -f /tmp/updates-available-*.tmp && touch /tmp/update-check-$(date +%Y-%m-%d).tmp" "\n${GREEN:-}[DONE]${NC:-$'\033[0m'}\n" "\n${YELLOW:-}[STOPPED]${NC:-$'\033[0m'}\n"
}

first_alias_line=${ssh_aliases[0]}
first_ssh_cmd=${ssh_aliases[0]#*=}
first_ssh_cmd=${first_ssh_cmd#\'}
first_ssh_cmd=${first_ssh_cmd%\'}
first_target=${first_ssh_cmd#ssh }

first_pane_cmd=$(build_pane_cmd "$first_target")
tmux new-session -d -s "$session" -n updates "bash -lc $(printf %q "$first_pane_cmd")"
tmux bind-key -n q kill-session -t "$session"
tmux set-hook -g session-closed 'unbind-key -n q'
tmux set-option -t "$session" mouse on
tmux set-option -t "$session" pane-border-status top
tmux set-option -t "$session" pane-border-format ' #{pane_title} '
tmux select-pane -t "$session:0.0" -T "$first_alias_line"

for ssh_alias in "${ssh_aliases[@]:1}"; do
    ssh_cmd=${ssh_alias#*=}
    ssh_cmd=${ssh_cmd#\'}
    ssh_cmd=${ssh_cmd%\'}
    ssh_target=${ssh_cmd#ssh }

    pane_cmd=$(build_pane_cmd "$ssh_target")
    pane_id=$(tmux split-window -t "$session:0" -d -P -F '#{pane_id}' "bash -lc $(printf %q "$pane_cmd")")
    tmux select-pane -t "$pane_id" -T "$ssh_alias"
    tmux select-layout -t "$session:0" tiled >/dev/null
done

if [[ -n ${TMUX:-} ]]; then
    tmux switch-client -t "$session"
else
    tmux attach -t "$session"
fi
