# --- NEW SRC ---
# SETTINGS
term_width=$(tput cols)
msg=$(cat << EOF
 Hello $(whoami)! 
EOF
)

# PROCESS EACH LINE
while IFS= read -r line; do
    # CALCULATE
    msg_len=${#line}
    pad_total=$((term_width - msg_len))
    (( pad_total < 0 )) && pad_total=0
    pad_side=$((pad_total / 2))
    left=$(printf '─%.0s' $(seq 1 "$pad_side"))
    right="$left"

    # ADD ONE EXTRA CHAR IF ODD
    if (( (msg_len + 2 * pad_side) < term_width )); then
        right+="─"
    fi

    # ECHO
    echo -e "${BOLD}${left}${line}${right}${NC}"
done <<< "$msg"

c_hostname=$(hostname)
if [[ "$c_hostname" == "t-vps" ]]; then
    colored_hostname="${ORANGE}$c_hostname${NC}"
elif [[ "$c_hostname" == "t-lap" ]]; then
    colored_hostname="${PURPLE}$c_hostname${NC}"
elif [[ "$c_hostname" == "t-k-debian" ]]; then
    colored_hostname="${CYAN}$c_hostname${NC}"
elif [[ "$c_hostname" == "t-v-debian" || "$c_hostname" == "t-pm" ]]; then
    colored_hostname="${GREEN}$c_hostname${NC}"
else
    colored_hostname="${RED}${c_hostname}${NC}"
fi
### HOSTNAME
echo -e "  ${BOLD}Hostname:${NC} ${PURPLE}$colored_hostname${NC}"
### LOCAL IPv4
echo -e "  ${BOLD}Local IPv4:${NC} ${PURPLE}$(local_ipv4=$(hostname -I 2>/dev/null | tr ' ' '\n' | grep -E '192\.168\.|217\.|10\.224\.' | uniq | xargs); [ -z "$local_ipv4" ] && echo -e ${RED}[ERROR] No IP found.${NC} || echo "$local_ipv4")${NC}"
### PUBLIC IPv4
echo -e "  ${BOLD}Public IPv4:${NC} ${PURPLE}$(IP=$(timeout 0.2 dig +short txt ch whoami.cloudflare @1.1.1.1 2>/dev/null | tr -d '"'); if [ -n "$IP" ]; then echo "$IP"; else curl -s https://icanhazip.com; fi)${NC}"
### VPN
if ls /etc/ 2>/dev/null | grep -i -E "wireguard" >/dev/null ; then
    vpn_ip=$(hostname -I 2>/dev/null | tr ' ' '\n' | grep -E '^10\.182\.' | uniq | xargs)
    if [[ -n "$vpn_ip" ]]; then
        echo -e "  ${BOLD}VPN:${NC} ${PURPLE}${vpn_ip}${NC}"
    else
        echo -e "  ${BOLD}VPN:${NC} ${RED}Disabled${NC}"
    fi
fi
### DNS NAMESERVERS
if [ -f /etc/resolv.conf ]; then
    echo -e "  ${BOLD}DNS:${NC} ${PURPLE}$(grep nameserver /etc/resolv.conf | grep -v 'run' | awk '{print $2}' | xargs)${NC}"
else
    echo -e "  ${BOLD}DNS:${NC} ${RED}[ERROR] /etc/resolv.conf file missing.${NC}"
fi
echo
