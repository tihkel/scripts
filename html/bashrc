# TERMCALL
termcall() (

    ## SETTINGS
    local RECEIVER_USER="tihkel"
    local RECEIVER_HOST="$1"
    local RECEIVER_MIC=""
    [[ *"$RECEIVER_HOST"* =~ "t-k-debian" ]] && local RECEIVER_MIC="AT2020" || local RECEIVER_MIC=""
    local RECEIVER_OUTPUT=""
    local CALL_FILE="$HOME/mic.opus"
    [ -f ~/scripts/.env ] || local SPEAK="espeak-ng -g6"
    local NOTIFY_START="$SPEAK 'incoming terminal call'"
    local NOTIFY_END="$SPEAK 'terminal call disconnected'"

    ## === DO NOT EDIT === ##
    set +m
    ## --listen-in
    if [[ "$*" == *"--listen-in"* ]]; then
        local NOTIFY_START="sleep 2; echo '[MUTED] Call started.'"
        echo "[MUTED] Call started."
        local NOTIFY_END="echo '[MUTED] Call ended.'"
    fi

    ## CLEANUP LAST CALL
    termux-microphone-record -q 2>/dev/null | grep -v "No recording to stop"
    rm -f "$CALLFILE"

    ## START RECORDING TERMUX MIC
    ( termux-microphone-record -f "$CALL_FILE" -r 48000 -e opus ) 2>/dev/null & disown
    sleep 1

    ## --listen-in
    if ! [[ "$*" == *"--listen-in"* ]]; then
        ## SEND MIC OUTPUT TO RECEIVER_HOST
        ( { tail -f "$CALL_FILE" | ssh "$RECEIVER_USER@$RECEIVER_HOST" "ffmpeg -f ogg -i pipe:0 -f pulse -device \$(pactl list sinks short | tr '[:upper:]' '[:lower:]' | awk '/$RECEIVER_OUTPUT/{print \$2}' | tail -n1) - 2>/dev/null"; } >/dev/null 2>&1 ) & disown
#        ( { tail -f "$CALL_FILE" | ssh "$RECEIVER_USER@$RECEIVER_HOST" "ffmpeg -f ogg -i pipe:0 -f pulse -device $RECEIVER_OUTPUT - 2>/dev/null"; } >/dev/null 2>&1 ) & disown
        MICREC_PID=$!
    fi

    ## GET AND PLAY RECEIVER_HOST MIC OUTPUT
    ssh "$RECEIVER_USER@$RECEIVER_HOST" "tmux kill-server >/dev/null 2>&1; $NOTIFY_START; arecord -D hw:\$(arecord -l | tr '[:upper:]' '[:lower:]' | grep card | awk 'BEGIN{IGNORECASE=0} /$RECEIVER_MIC/{print \$2}' | tr -d ':' | tail -n1),0 -f cd -" | mpv --msg-level=all=no,statusline=status --no-cache --audio-buffer=0.05 --cache-pause=no --demuxer=rawaudio --demuxer-rawaudio-rate=44100 --demuxer-rawaudio-channels=2 --demuxer-rawaudio-format=s16le /dev/stdin

    ## CLEANUP CURRENT CALL
    kill $MICREC_PID 2>/dev/null
    termux-microphone-record -q 2>/dev/null
    ssh "$RECEIVER_USER@$RECEIVER_HOST" "$NOTIFY_END; pkill -f ffmpeg"
    rm -f ~/mic.opus
    ssh "$RECEIVER_USER@$RECEIVER_HOST" "tmux kill-server >/dev/null 2>&1"

    set -m
)


