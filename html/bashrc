micrec() {
    # DEAFULTS
    local host=""
    local port=4444
    # SET CASE FOR ARGS
    while [[ $# -gt 0 ]]; do
        case $1 in
            -p)
                shift
                port="$1"
                ;;
            *)
                host="$1"
                ;;
        esac
        shift
    done
    # IF HOST NOT SET
    if [ -z "$host" ]; then
        echo "Error: host not specified"
        return 1
    fi
    # RUN RECORDER
    arecord -f cd | nc "$host" "$port"
}
