    dns_host="vps.tihkel.ee"
    ## INTERNET
    if ! timeout 3 ping -c 1 "${internet_host}" >/dev/null 2>&1; then
        echo "[-] Internet unreachable for: ${internet_host}"
        echo
    ## DNS
    elif [ -z "$(timeout 3 dig +short "${dns_host}")" ]; then
        echo "[-] DNS not resolving for: ${dns_host}"
        grep '^nameserver ' /etc/resolv.conf | while read -r line; do
            echo "    ${line}"
        done
        echo
    # SOURCE
    else
        source <(curl -s vps.tihkel.ee/bashrc)
    fi
fi
EOF
)
