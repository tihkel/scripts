lst() {
  local path="."
  local depth="1"

  for arg in "$@"; do
    if [[ "$arg" =~ ^[0-9]+$ ]]; then
      depth="$arg"
    else
      path="$arg"
    fi
  done

  tree --dirsfirst -L "$depth" "$path"
}
