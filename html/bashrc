# SOUND TUNNEL
tun() {
    if ! command -v pactl >/dev/null 2>&1; then
        echo "Error: 'pactl' command not found."
        return 1
    fi

    local MAKE_T="native-protocol-tcp"
    local ADD_T="tunnel-sink"
    local LOCAL_T="loopback"

    case "$1" in
        list)
            for name in MAKE_T ADD_T LOCAL_T; do
                pat="${!name}"
                ids=$(pactl list short modules | awk "/$pat/ {print \$1}")
                if [ -n "$ids" ]; then
                    echo "$name:"
                    echo "$ids" | awk '{print "  " $1}'
                fi
            done
            ;;
        make)
            pactl load-module module-native-protocol-tcp auth-anonymous=1
            ;;
        rem)
            ids=$(pactl list short modules | awk "/$MAKE_T/ {print \$1}")
            if [ -z "$ids" ]; then
                echo "No receiver tunnels exist."
            else
                for id in $ids; do
                    echo "Removing receiver id: $id"
                    pactl unload-module "$id"
                done
            fi
            ;;
        add)
            if [ "$2" = "local" ]; then
                ids=$(pactl list short modules | awk "/$ADD_T/ {print \$1}")
                if [ -z "$ids" ]; then
                    echo "Error: Load transmitter first."
                else
                    pactl load-module module-loopback source=remote.monitor sink=alsa_output.pci-0000_00_1f.3.analog-stereo latency_msec=255 tsched=0
                fi
            else
                pactl load-module module-tunnel-sink server=t-k-debian.vpn sink_name=remote latency_msec=200 rate=48000 channels=2
                #pactl load-module module-tunnel-sink server=t-k-debian.vpn sink_name=remote latency_msec=130 tsched=0
                pactl set-default-sink remote 2>/dev/null
            fi
            ;;
        del)
            if [ "$2" = "local" ]; then
                ids=$(pactl list short modules | awk "/$LOCAL_T/ {print \$1}")
                if [ -z "$ids" ]; then
                    echo "No local tunnels exist."
                else
                    for id in $ids; do
                        echo "Deleting local id: $id"
                        pactl unload-module "$id"
                    done
                fi
            else
                ids=$(pactl list short modules | awk "/$ADD_T/ {print \$1}")
                if [ -z "$ids" ]; then
                    echo "No transmitter tunnels exist."
                else
                    for id in $ids; do
                        echo "Deleting transmitter id: $id"
                        pactl unload-module "$id"
                    done
                fi
            fi
            ;;
        *)
            echo "Error: Missing argument."
            ;;
    esac
}


