#!/usr/bin/env bash
source ~/scripts/.env

# --- PARAMS ---
max_days=3
while getopts ":n:" opt; do
    case $opt in
        n) max_days=$OPTARG ;;
        *) exit 1 ;;
    esac
done

if ! [[ "$max_days" =~ ^[0-9]+$ ]] || [ "$max_days" -lt 1 ]; then
    echo "Usage: bash $0 [-n days]"
    exit 1
fi

# --- CALENDAR URLS/COLORS ---
ICAL_URLS=("${MYCAL_URLS[@]}")
ICAL_COLORS=("${MYCAL_COLORS[@]}")
RESET="$NC"

if [ ${#ICAL_URLS[@]} -eq 0 ]; then
    echo "MYCAL_URLS is not set in ~/scripts/.env"
    exit 1
fi

if [ ${#ICAL_COLORS[@]} -eq 0 ]; then
    echo "MYCAL_COLORS is not set in ~/scripts/.env"
    exit 1
fi

# --- SETTINGS ---
TMPDIR=$(mktemp -d)
declare -A DAYS
ORDERED_KEYS=()

repeat_char() {
    local char="$1"
    local count="$2"
    local out=""
    local i

    for ((i = 0; i < count; i++)); do
        out+="$char"
    done

    printf '%s' "$out"
}

print_header() {
    local label="$1"
    local inner_width=32
    local text=" $label "
    local pad=$((inner_width - ${#text}))

    if [ "$pad" -lt 0 ]; then
        pad=0
    fi

    local left=$((pad / 2))
    local right=$((pad - left))
    printf -- '──┬%s%s%s\n' "$(repeat_char '─' "$left")" "$text" "$(repeat_char '─' "$right")"
}

# --- FORMATTING ---
for i in $(seq 0 $((max_days - 1))); do
    date_str=$(date -d "+$i day" +%Y%m%d)
    if [ $i -eq 0 ]; then
        label="Today ($(date -d "+$i day" +%d.%m))"
    elif [ $i -eq 1 ]; then
        label="Tomorrow ($(date -d "+$i day" +%d.%m))"
    elif [ $i -eq 2 ]; then
        label="After tomorrow ($(date -d "+$i day" +%d.%m))"
    else
        label=$(date -d "+$i day" +%d.%m)
    fi
    DAYS[$date_str]="$label"
    ORDERED_KEYS+=("$date_str")
done

# --- PROCESS CAL FILES ---
for i in "${!ICAL_URLS[@]}"; do
    ICAL_URL="${ICAL_URLS[$i]}"
    ICAL_URL="${ICAL_URL/#webcal:\/\//https://}"
    TMPFILE="$TMPDIR/cal_$i.ics"
    curl -s -k "$ICAL_URL" -o "$TMPFILE" || continue

    awk -v idx="$i" -v maxdays="$max_days" '
BEGIN {
    in_event=0
    today=strftime("%Y%m%d")
    window_end=strftime("%Y%m%d", systime() + ((maxdays - 1) * 86400))
}
/^BEGIN:VEVENT/ {
    in_event=1
    summary=""
    dtstart=""
    dtend=""
    rrule=""
    status=""
    delete exdates
}
/^END:VEVENT/ {
    if (in_event && dtstart != "" && summary != "" && status != "CANCELLED") {
        gsub(/\r/, "", dtstart)
        gsub(/\r/, "", dtend)
        gsub(/\r/, "", rrule)

        start=substr(dtstart,1,8)
        end=(dtend != "" ? substr(dtend,1,8) : start)
        if (end < start) end=start

# Subtract one day from DTEND (since it is exclusive)
cmd = "date -d \"" end " -1 day\" +%Y%m%d"
cmd | getline end_adj
close(cmd)
if (end_adj < start) end_adj = start   # <-- add this line


        cur=start
        while (cur <= end_adj) {
            if (cur >= today && !(cur in exdates))
                print idx "\t" cur "\t" summary
            cmd = "date -d \"" cur " +1 day\" +%Y%m%d"
            cmd | getline cur
            close(cmd)
        }

        # yearly recurrence
        if (rrule ~ /FREQ=YEARLY/) {
            month_day=substr(start,5,4)
            year=strftime("%Y")
            cur_year_event=year month_day
            if (cur_year_event >= today && cur_year_event <= window_end && !(cur_year_event in exdates)) {
                print idx "\t" cur_year_event "\t" summary
            }
        }

        # weekly recurrence
        if (rrule ~ /FREQ=WEEKLY/) {
            recur=start
            until=""
            if (rrule ~ /UNTIL=/) {
                until=rrule
                sub(/^.*UNTIL=/, "", until)
                sub(/;.*/, "", until)
            }

            while (recur < today) {
                cmd = "date -d \"" recur " +7 days\" +%Y%m%d"
                cmd | getline recur
                close(cmd)
            }

            while (recur <= window_end) {
                if ((until == "" || recur <= until) && !(recur in exdates))
                    print idx "\t" recur "\t" summary
                cmd = "date -d \"" recur " +7 days\" +%Y%m%d"
                cmd | getline recur
                close(cmd)
            }
        }
    }
    in_event=0
}
/^SUMMARY:/ && in_event { sub(/^SUMMARY:/,""); summary=$0 }
/^DTSTART/ && in_event { sub(/^DTSTART[^:]*:/,""); dtstart=$0 }
/^DTEND/ && in_event { sub(/^DTEND[^:]*:/,""); dtend=$0 }
/^RRULE/ && in_event { sub(/^RRULE:/,""); rrule=$0 }
/^EXDATE/ && in_event {
    sub(/^EXDATE[^:]*:/,"")
    gsub(/\r/, "")
    split($0, exdate_parts, ",")
    for (j in exdate_parts)
        exdates[substr(exdate_parts[j], 1, 8)] = 1
}
/^STATUS:/ && in_event { sub(/^STATUS:/,""); status=$0 }
' "$TMPFILE"
done | sort -k2,2n | awk '!seen[$2"\t"$3]++' > "$TMPDIR/events.txt"

# --- DISPLAY ---
day_counter=0
for day in "${ORDERED_KEYS[@]}"; do
    header="${DAYS[$day]}"
    events=$(awk -F'\t' -v d="$day" '$2 ~ "^" d {print}' "$TMPDIR/events.txt")

    if [ $day_counter -eq 3 ]; then echo; echo; fi
    print_header "$header"
    if [ -n "$events" ]; then
        echo "$events" | while IFS=$'\t' read -r color_idx rawdate summary; do
            COLOR="${ICAL_COLORS[$color_idx]}"
            echo -e "${COLOR}  │ ${summary}${RESET}"
        done
    fi
    ((day_counter++))
done

rm -rf "$TMPDIR"
