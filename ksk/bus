#!/bin/bash
echo "" > ~/bus.debug


# --- CONFIG ---
BUS_SPEED=3.3
BAN_DISTANCE=20
MAPSCII_ZOOM=9.7
# --- END OF CONFIG ---
source ~/scripts/.env


# --- USAGE ---
declare -A DICT=(
    ["USAGE"]="bash $0 <required_args>"
    ["INFO"]="Live bus location script."
    ["-b <bus_number>"]="Number of the bus to view."
    ["-d <final_stop>"]="Direction the bus is moving towords (final stop)."
    ["-s <bus_stop>"]="Stop name to set as current location."
)
source <(curl -s vps.tihkel.ee/usage) DICT "$@"


# --- PARAMS ---
while getopts "b:d:s:" opt; do
  case $opt in
    b) BUS_NUM="$OPTARG" ;;
    d) BUS_DIRECTION_STOP="$OPTARG" ;;
    s) BUS_STOP="$OPTARG" ;;
  esac
done


# --- CHECK REQUIRED PARAMS ---
if [[ -z "$BUS_NUM" || -z "$BUS_DIRECTION_STOP" || -z "$BUS_STOP" ]]; then
  echo "ERROR: Missing required args."
  echo -e "Usage: \n  bash $0 -b <bus_number> -d <direction_stop> -s <bus_stop>"
  exit 1
fi


# --- SET COORDINATES FROM <bus_stop> ARG ---
case "$BUS_STOP" in
  zone)
    BUS_STOP_LAT=$ZONE_LAT
    BUS_STOP_LON=$ZONE_LON
    ;;
  kodu)
    BUS_STOP_LAT=$KODU_LAT
    BUS_STOP_LON=$KODU_LON
    ;;
  *)
    echo "ERROR: Provided '<bus_stop>' not set."
    exit 1
    ;;
esac


# --- DISTANCE FUNCTION ALGORYTM ---
haversine_m() {
  awk -v lat1="$1" -v lon1="$2" -v lat2="$3" -v lon2="$4" '
  BEGIN {
    pi=atan2(0,-1)
    R=6371000

    dlat=(lat2-lat1)*pi/180
    dlon=(lon2-lon1)*pi/180

    a=sin(dlat/2)^2 + cos(lat1*pi/180)*cos(lat2*pi/180)*sin(dlon/2)^2
    c=2*atan2(sqrt(a),sqrt(1-a))

    printf "%.0f", R*c
  }'
}


# --- TOP LEFT BUS LABEL ---
LABEL_PID=""
restart_label() {
    local DISTANCE="$1"
    local ETA="$2"

    if [[ -n "$LABEL_PID" ]]; then
    kill "$LABEL_PID" 2>/dev/null
    fi

    (
    while true; do
      tput cup 0 0
      tput el
      echo -ne "\e[1;36mBus: $BUS_NUM -> $BUS_DIRECTION_STOP (${ETA} min) ${DISTANCE}m\e[0m"
      sleep 0.4
    done
    ) &

    LABEL_PID=$!
}


# --- START INITIAL LABEL ---
#BUS_DISTANCE_IN_M="?"
#BUS_ARRIVAL_ETA_IN_MIN="?"
#restart_label "$BUS_DISTANCE_IN_M" "$BUS_ARRIVAL_ETA_IN_MIN"


# --- MIDDLE RED DOT ---
restart_red_dot() {
    if [[ -n "$RED_DOT_PID" ]]; then
        kill "$RED_DOT_PID" 2>/dev/null
    fi

    (
      while true; do
        TERM_ROW=$(( $(tput lines) / 2 - 1 ))
        TERM_COL=$(( $(tput cols) / 2 - 1 ))
        tput cup "$TERM_ROW" "$TERM_COL"
        echo -ne "\e[1;31m●\e[0m"
        sleep 0.4
      done
    ) &

    RED_DOT_PID=$!
}


# --- CLEANUP ---
cleanup() {
    kill "$RED_DOT_PID" 2>/dev/null
    kill "$LABEL_PID" 2>/dev/null
    tput sgr0
    echo
    exit
}
trap cleanup INT TERM


# --- MAIN LOOP ---
BANNED_BUS_ID=""
while true; do
    TLT_BUS_DATA=$(curl -s https://transport.tallinn.ee/gps.txt | awk -F, -v b="$BUS_NUM" -v f="$BUS_DIRECTION_STOP" '$2 == b && $10 == f')

    CLOSEST_BUS_LINE=""
    CLOSEST_DISTANCE=9999999999
    CLOSEST_BUS_ID=""

    # READ EACH BUS CANDIDATE
    while IFS= read -r BUS_LINE; do
        BUS_LINE_LON_RAW=$(echo "$BUS_LINE" | cut -d, -f3)
        BUS_LINE_LAT_RAW=$(echo "$BUS_LINE" | cut -d, -f4)
        BUS_LINE_ID=$(echo "$BUS_LINE" | cut -d, -f7)

        # SKIP BANNED BUS ID
        if [[ "$BANNED_BUS_ID" == "$BUS_LINE_ID" ]]; then
          echo "DEBUG: BUS $BUS_LINE_ID SKIPPED (BANNED)" >> ~/bus.debug
          continue
        fi

        # CONVERT RAW COORDINATES
        BUS_LINE_LAT=$(awk "BEGIN {print $BUS_LINE_LAT_RAW / 1000000}")
        BUS_LINE_LON=$(awk "BEGIN {print $BUS_LINE_LON_RAW / 1000000}")
        # CALCULATE SQUARED DISTANCE TO BUS STOP
        SQUARED_DISTANCE=$(awk -v lat="$BUS_LINE_LAT" -v lon="$BUS_LINE_LON" \
                   -v STOP_LAT="$BUS_STOP_LAT" -v STOP_LON="$BUS_STOP_LON" '
            BEGIN {
              dx = lat - STOP_LAT
              dy = lon - STOP_LON
              print dx*dx + dy*dy
            }')


        real_BUS_DISTANCE_IN_M=$(haversine_m "$BUS_LINE_LAT" "$BUS_LINE_LON" "$BUS_STOP_LAT" "$BUS_STOP_LON")
        echo "DEBUG: real_BUS_DISTANCE_IN_M=$real_BUS_DISTANCE_IN_M" >> ~/bus.debug

        if awk -v a="$SQUARED_DISTANCE" -v b="$CLOSEST_DISTANCE" 'BEGIN {exit !(a < b)}'; then
            if awk -v d="$real_BUS_DISTANCE_IN_M" -v b="$BAN_DISTANCE" 'BEGIN {exit !(d > b)}'; then
#        if (( SQUARED_DISTANCE < CLOSEST_DISTANCE )); then
#            if (( real_BUS_DISTANCE_IN_M > BAN_DISTANCE )); then
                CLOSEST_DISTANCE=$SQUARED_DISTANCE
                CLOSEST_BUS_LINE=$BUS_LINE
                CLOSEST_BUS_ID=$BUS_LINE_ID
            else
                BANNED_BUS_ID="$BUS_LINE_ID"
                continue
            fi
        fi

    done <<< "$TLT_BUS_DATA"

    # MANAGE CLOSEST BUS
    BUS_LINE_LON_RAW=$(echo "$CLOSEST_BUS_LINE" | cut -d, -f3)
    BUS_LINE_LAT_RAW=$(echo "$CLOSEST_BUS_LINE" | cut -d, -f4)

    if [[ -n "$BUS_LINE_LON_RAW" && -n "$BUS_LINE_LAT_RAW" ]]; then
        BUS_LINE_LON=$(awk "BEGIN {printf \"%.6f\", $BUS_LINE_LON_RAW/1000000}")
        BUS_LINE_LAT=$(awk "BEGIN {printf \"%.6f\", $BUS_LINE_LAT_RAW/1000000}")

        BUS_DISTANCE_IN_M=$(haversine_m "$BUS_LINE_LAT" "$BUS_LINE_LON" "$BUS_STOP_LAT" "$BUS_STOP_LON")

        # --- ETA CALC ---
        BUS_ARRIVAL_ETA_IN_MIN=$(awk -v dist="$BUS_DISTANCE_IN_M" -v speed="$BUS_SPEED" '
            BEGIN {
              if (speed > 0) printf "%.0f", dist / speed / 60
              else print "?"
            }')

        if [[ "$BUS_DISTANCE_IN_M" -lt 30 ]]; then
          BUS_ARRIVAL_ETA_IN_MIN="0"
        fi

        restart_red_dot
        restart_label "$BUS_DISTANCE_IN_M" "$BUS_ARRIVAL_ETA_IN_MIN"

        node ~/mapscii/main.js -z "$MAPSCII_ZOOM" --lat "${BUS_LINE_LAT}" --lon "${BUS_LINE_LON}" &
        MAPSCII_PID=$!

        sleep 0.3
        wait "$MAPSCII_PID"
    else
#        BUS_DISTANCE_IN_M="?"
#        BUS_ARRIVAL_ETA_IN_MIN="?"
#        restart_label "$BUS_DISTANCE_IN_M" "$BUS_ARRIVAL_ETA_IN_MIN"

        echo "ERROR: No matching busses found for: $BUS_NUM -> $BUS_DIRECTION_STOP"
        sleep 10
    fi
done
