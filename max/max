#!/bin/bash
source ~/scripts/.env

# --- USAGE ---
declare -A DICT=(
    ["USAGE"]="bash $0 [command]"
    ["INFO"]="Personal home assistant + LLM."
    ["'lights <on|off>'"]="Turn lights on/off."
    ["'volume <up|down>'"]="Turn volume up/down."
    ["'wake up'"]="Run moring commands."
    ["'im back'"]="Run welcome commands."
    ["'kill'"]="Resets/kills kiosk/tmux session."
    ["'reset'"]="Resets volume for all devices."
)
source <(curl -s vps.tihkel.ee/usage) DICT "$@"


# --- SETTINGS ---
LISTEN_MODE=0
LAST_COMMAND_TIME=0
CURRENT_VOLUME=""
LISTEN_VOLUME=-20%
TIMEOUT=30
export VOSK_LOG_LEVEL=-1
LOG_FILE="/tmp/max.log"
ACKNOWLEDGEMENT_WORDS=("okay" "alright" "right on it" "done" "got it" "roger" "copy that" "on it" "affirmative" "sure thing" "no problem" "will do" "10 4" "consider it done" "say no more" "handled" "gotcha" "on the case")
LISTENING_WORDS=("yes sir" "what's up" "yes?" "listening" "whats good" "yo" "sup" "go ahead" "i'm here" "shoot" "present" "at your service")
CLOSING_WORDS=("you're welcome" "no problem" "no worries" "we good" "all good" "anytime" "don't mention it" "happy to help" "glad to help" "it's nothing" "yep" "of course" "no big deal" "cool")
#CONFUSED_WORDS=("what?" "huh?" "sorry?" "pardon?" "pardon me?" "come again?" "say again?" "repeat that" "could you repeat that?" "didn't catch that" "i didn't catch that" "can you say that again?" "say that again" "excuse me?" "wait what" "one more time" "run that back" "come again" "hmm?" "sorry, what was that?")
# --- END OF SETTINGS ---


# --- FUNCTIONS ---
## LOGGING
log() {
    local COLOR_NAME=$1
    shift
    local DATE=$(date +'%Y-%m-%d %H:%M:%S')
    local PRE_LOG="${GRAY}[$DATE]${NC} "
    if [[ "$COLOR_NAME" == "RED" ]]; then
        PRE_LOG="${GRAY}[$(date +'%H:%M:%S')]${NC} "
    fi
    local COLOR="${!COLOR_NAME}"
    local INPUT=$*
    [[ -n "$1" ]] && [[ -n "$cmd" ]] && [[ "$COLOR_NAME" == "GREEN" ]] && echo -e "${CYAN}Heard: $cmd${NC}" | tee -a "$LOG_FILE"
    echo -e "$PRE_LOG${COLOR}$INPUT${NC}" | tee -a "$LOG_FILE"
}

## GENERATE RANDOM ACKNOWLEDGEMENT WORD
acknowledge() {
    $SPEAK "${ACKNOWLEDGEMENT_WORDS[$((RANDOM % ${#ACKNOWLEDGEMENT_WORDS[@]}))]}"
}

## GENERATE RANDOM LISTENING WORD
listening() {
    $SPEAK "${LISTENING_WORDS[$((RANDOM % ${#LISTENING_WORDS[@]}))]}"
}
## GENERATE RANDOM CLOSING WORD
closing() {
    $SPEAK "${CLOSING_WORDS[$((RANDOM % ${#CLOSING_WORDS[@]}))]}"
}
## GENERATE RANDOM CONFUSED WORD
#confused() {
#    $SPEAK "${CONFUSED_WORDS[$((RANDOM % ${#CONFUSED_WORDS[@]}))]}"
#}


# --- BACKGROUND SCRIPTS ---
## CHECK IF HOME
CHECK_IF_HOME_SCRIPT="/home/$USER/scripts/max/check-if-home"
if ! pgrep -fx "bash $CHECK_IF_HOME_SCRIPT" >/dev/null; then
    bash "$CHECK_IF_HOME_SCRIPT" >/dev/null 2>&1 &
fi
## ALARMS
ALARMS_SCRIPT="/home/$USER/scripts/max/alarms"
if ! pgrep -fx "bash $ALARMS_SCRIPT" >/dev/null; then
    bash "$ALARMS_SCRIPT" >/dev/null 2>&1 &
fi


# --- MAIN COMMAND HANDLER ---
handle_command() {
    local cmd="$1"

    # --- SKIP SKISO WORDS ---
    if [[ "$cmd" =~ ^(huh|the|okay|you\'re welcome)$ || "$cmd" == *"yes sir"* || "$cmd" == *"wait"* ]]; then
        return
    fi

    # --- WAKE WORDS ---
    wake_words="(max|hi max|lex|rex)"
    if [[ "$cmd" =~ ^$wake_words\ .+ ]]; then
        LISTEN_MODE=1
        LAST_COMMAND_TIME=$(date +%s)
        CURRENT_VOLUME=$(pactl get-sink-volume @DEFAULT_SINK@ | awk '{print $5}' | head -n1)
        pactl set-sink-volume @DEFAULT_SINK@ $LISTEN_VOLUME
        log GREEN "Listening..."
    elif [[ "$cmd" =~ ^$wake_words$ ]]; then
        LISTEN_MODE=1
        LAST_COMMAND_TIME=$(date +%s)
        CURRENT_VOLUME=$(pactl get-sink-volume @DEFAULT_SINK@ | awk '{print $5}' | head -n1)
        pactl set-sink-volume @DEFAULT_SINK@ $LISTEN_VOLUME
        log GREEN "Listening..."; listening &
        return 0
    fi

    # --- SHOW HEARD COMMANDS ---
    if [[ $LISTEN_MODE -eq 0 ]]; then
        log RED "$cmd"
        return 0
    fi

    # --- TIMEOUT CHECK ---
    local now=$(date +%s)
    if (( now - LAST_COMMAND_TIME > TIMEOUT )); then
        LISTEN_MODE=0
        log YELLOW "Timeout. Exiting..."; $SPEAK "timeout"
        pactl set-sink-volume @DEFAULT_SINK@ "$CURRENT_VOLUME"
        return 0
    fi
    LAST_COMMAND_TIME=$now

    # --- EXIT WORD ---
    if [[ "$cmd" == *"thanks"* || "$cmd" == *"thank you"* || "$cmd" == *"nothing"* || "$cmd" == *"never mind"* ]]; then
        LISTEN_MODE=0
        log GREEN "Exiting..."; closing &
        pactl set-sink-volume @DEFAULT_SINK@ "$CURRENT_VOLUME"
        return 0
    fi

    # --- COMMANDS ---
    case "$cmd" in
        # --- PLAYBACK ---
        *"play"*)
            log GREEN "Playing music..."; $SPEAK "playing" &
            playerctl play
            pactl set-sink-volume @DEFAULT_SINK@ "$CURRENT_VOLUME"
            LISTEN_MODE=0
            return 0
            ;;
        *"pause"*|*"stop"*|*"shut up"*)
            log GREEN "Stopping playback..."; acknowledge &
            playerctl stop
            pactl set-sink-volume @DEFAULT_SINK@ "$CURRENT_VOLUME"
            LISTEN_MODE=0
            return 0
            ;;
        *"skip"*|*"skin"*)
            log GREEN "Skipping..."; acknowledge &
            playerctl next
            ;;
        *"volume up"*)
            log GREEN "Turning volume up..."; $SPEAK "turning volume up" &
            pactl set-sink-volume @DEFAULT_SINK@ +25%
            CURRENT_VOLUME=$(pactl get-sink-volume @DEFAULT_SINK@ | awk '{print $5}' | head -n1)
            LISTEN_MODE=0
            return 0
            ;;
        *"volume down"*)
            log GREEN "Turning volume down..."; $SPEAK "turning volume down" &
            pactl set-sink-volume @DEFAULT_SINK@ -25%
            CURRENT_VOLUME=$(pactl get-sink-volume @DEFAULT_SINK@ | awk '{print $5}' | head -n1)
            LISTEN_MODE=0
            return 0
            ;;
        *"reset"*|*"recent"*)
            log GREEN "Resetting volume..."; acknowledge &
            pactl set-sink-volume @DEFAULT_SINK@ 100%
            pactl set-sink-volume $(pactl list short sinks | awk '/hdmi/{print $2}') 100%
            playerctl volume 0.8 -p spotify
            timeout 5 catt -d "$TV_IP" volume 40
            CURRENT_VOLUME=$(pactl get-sink-volume @DEFAULT_SINK@ | awk '{print $5}' | head -n1)
            LISTEN_MODE=0
            return 0
            ;;
        *"spotify"*)
            cmd="${cmd#* }" # REMOVE FIRST WORD
            acknowledge &
            log GREEN "$(bash ~/scripts/max/s-query \"$cmd\")"
            ;;

        # --- LIGHTS ---
        *"lights on"*)
            log GREEN "Turning on lights..."; acknowledge
            node ~/scripts/tuya-control/remote.js bulb-1 on
            node ~/scripts/tuya-control/remote.js bulb-1 mode scene purplebulb
            node ~/scripts/tuya-control/remote.js bulb-2 on
            node ~/scripts/tuya-control/remote.js bulb-2 mode scene purplebulb
            node ~/scripts/tuya-control/remote.js led on
            node ~/scripts/tuya-control/remote.js led mode scene purpleled
            node ~/scripts/tuya-control/remote.js pluh-1 on
            pactl set-sink-volume @DEFAULT_SINK@ "$CURRENT_VOLUME"
            LISTEN_MODE=0
            return 0
            ;;
        *"lights off"*)
            log GREEN "Turning off lights..."; acknowledge &
            node ~/scripts/tuya-control/remote.js bulb-1 off
            node ~/scripts/tuya-control/remote.js bulb-2 off
            node ~/scripts/tuya-control/remote.js led off
            node ~/scripts/tuya-control/remote.js pluh-1 off
            node ~/scripts/tuya-control/remote.js pluh-2 off
            node ~/scripts/tuya-control/remote.js pluh-2 on
            pactl set-sink-volume @DEFAULT_SINK@ "$CURRENT_VOLUME"
            LISTEN_MODE=0
            return 0
            ;;
        *"color red"*)
            log GREEN "Turning on red mode..."; acknowledge &
            node ~/scripts/tuya-control/remote.js bulb-1 on
            node ~/scripts/tuya-control/remote.js bulb-1 mode color red
            node ~/scripts/tuya-control/remote.js bulb-2 on
            node ~/scripts/tuya-control/remote.js bulb-2 mode color red
            node ~/scripts/tuya-control/remote.js led on
            node ~/scripts/tuya-control/remote.js led mode color red
            node ~/scripts/tuya-control/remote.js pluh-1 off
            node ~/scripts/tuya-control/remote.js pluh-2 off
            pactl set-sink-volume @DEFAULT_SINK@ "$CURRENT_VOLUME"
            LISTEN_MODE=0
            return 0
            ;;
        *"movie"*)
            log GREEN "Turning on movie mode..."; acknowledge &
            pactl set-sink-volume @DEFAULT_SINK@ "$CURRENT_VOLUME"
            LISTEN_MODE=0
            playerctl stop
            node ~/scripts/tuya-control/remote.js bulb-1 on
            node ~/scripts/tuya-control/remote.js bulb-1 mode scene purplebulb
            node ~/scripts/tuya-control/remote.js bulb-2 on
            node ~/scripts/tuya-control/remote.js bulb-2 mode color magenta
            node ~/scripts/tuya-control/remote.js led off
            node ~/scripts/tuya-control/remote.js pluh-1 on
            node ~/scripts/tuya-control/remote.js pluh-2 on
            return 0
            ;;
        *"orange"*)
            log GREEN "Turning on orange mode..."; acknowledge &
            node ~/scripts/tuya-control/remote.js bulb-1 on
            node ~/scripts/tuya-control/remote.js bulb-1 mode color orangebulb
            node ~/scripts/tuya-control/remote.js bulb-2 on
            node ~/scripts/tuya-control/remote.js bulb-2 mode color orangebulb
            node ~/scripts/tuya-control/remote.js led on
            node ~/scripts/tuya-control/remote.js led mode color orangeled
            node ~/scripts/tuya-control/remote.js pluh-1 on
            ;;
        *"ocean"*)
            log GREEN "Turning on ocean mode..."; acknowledge &
            node ~/scripts/tuya-control/remote.js bulb-1 on
            node ~/scripts/tuya-control/remote.js bulb-1 mode color bluebulb
            node ~/scripts/tuya-control/remote.js bulb-2 on
            node ~/scripts/tuya-control/remote.js bulb-2 mode color bluebulb
            node ~/scripts/tuya-control/remote.js led on
            node ~/scripts/tuya-control/remote.js led mode color blueled
            node ~/scripts/tuya-control/remote.js pluh-1 on
            ;;
        *"hardcore"*)
            log GREEN "Turning on hardcore mode..."; acknowledge &
            node ~/scripts/tuya-control/remote.js bulb-1 on
            node ~/scripts/tuya-control/remote.js bulb-1 mode scene hardcore
            node ~/scripts/tuya-control/remote.js bulb-2 on
            node ~/scripts/tuya-control/remote.js bulb-2 mode scene hardcore
            node ~/scripts/tuya-control/remote.js led on
            node ~/scripts/tuya-control/remote.js led mode scene hardcore
            node ~/scripts/tuya-control/remote.js pluh-1 on
            ;;
        *"disco"*)
            log GREEN "Turning on disco mode..."; acknowledge &
            node ~/scripts/tuya-control/remote.js bulb-1 on
            node ~/scripts/tuya-control/remote.js bulb-1 mode scene disco
            node ~/scripts/tuya-control/remote.js bulb-2 on
            node ~/scripts/tuya-control/remote.js bulb-2 mode scene disco
            node ~/scripts/tuya-control/remote.js led on
            node ~/scripts/tuya-control/remote.js led mode scene disco
            node ~/scripts/tuya-control/remote.js pluh-1 on
            ;;
        *"white"*)
            log GREEN "Turning on white mode..."; acknowledge &
            node ~/scripts/tuya-control/remote.js bulb-1 on
            node ~/scripts/tuya-control/remote.js bulb-1 mode white
            node ~/scripts/tuya-control/remote.js bulb-2 on
            node ~/scripts/tuya-control/remote.js bulb-2 mode white
            node ~/scripts/tuya-control/remote.js led on
            node ~/scripts/tuya-control/remote.js led mode color whiteled
            node ~/scripts/tuya-control/remote.js pluh-1 on
            ;;
        *"seizure"*|*"flash"*|*"flesh"*)
            log GREEN "Turning on seizure mode..."; acknowledge &
            nohup node ~/scripts/tuya-control/remote.mjs >/dev/null 2>&1 &
            echo $! > /tmp/tuya-beat.pid
            ;;
        *"calm down"*)
            log GREEN "Turning off seizure mode..."; acknowledge &
            kill $(cat /tmp/tuya-beat.pid) && rm -rf /tmp/tuya-beat.pid
            ;;

        # --- OTHER ---
        *"sheleft"*)
            log GREEN "She left."; $SPEAK "she left" &
            node ~/scripts/tuya-control/remote.js bulb-1 mode scene flash_red_pink
            node ~/scripts/tuya-control/remote.js bulb-2 mode scene flash_red_pink
            sleep 5
            node ~/scripts/tuya-control/remote.js bulb-1 mode scene purplebulb
            node ~/scripts/tuya-control/remote.js bulb-2 mode scene purplebulb
            ;;
        *"kill"*)
            log GREEN "Killing kiosk..."; $SPEAK "killing keyyawsk"
            pactl set-sink-volume @DEFAULT_SINK@ "$CURRENT_VOLUME"
            tmux kill-server
            ;;
        *"shut down"*|*"shot down"*|*"shut though"*|*"shot though"*)
            log GREEN "Shutting down..."; $SPEAK "shutting down" &
            timeout 5 ssh t-pirukas "sudo ddcutil setvcp 0xD6 4 2>/dev/null"
            node ~/scripts/tuya-control/remote.js bulb-1 off
            node ~/scripts/tuya-control/remote.js bulb-2 off
            node ~/scripts/tuya-control/remote.js led off
            node ~/scripts/tuya-control/remote.js pluh-1 off
            node ~/scripts/tuya-control/remote.js pluh-2 off
            node ~/scripts/tuya-control/remote.js pluh-2 on
            playerctl stop -p spotify
            adb -s "$TV_IP" shell input keyevent KEYCODE_SLEEP
            pactl set-sink-volume @DEFAULT_SINK@ "$CURRENT_VOLUME"
            LISTEN_MODE=0
            return 0
            ;;
        *"wake up"*)
            log GREEN "Good morning..."
            pactl set-sink-volume @DEFAULT_SINK@ 40%
            playerctl volume 0.7 -p spotify
            $SPEAK "good morning!"
            playerctl next -p spotify
            adb -s "$TV_IP" shell input keyevent KEYCODE_WAKEUP
            timeout 5 ssh t-pirukas "sudo ddcutil setvcp 0xD6 1 2>/dev/null"
            timeout 5 catt -d "$TV_IP" volume 40
            node ~/scripts/tuya-control/remote.js bulb-1 on
            node ~/scripts/tuya-control/remote.js bulb-1 mode color orangebulb
            node ~/scripts/tuya-control/remote.js bulb-2 on
            node ~/scripts/tuya-control/remote.js bulb-2 mode color orangebulb
            node ~/scripts/tuya-control/remote.js led on
            node ~/scripts/tuya-control/remote.js led mode color orangeled
            node ~/scripts/tuya-control/remote.js pluh-1 on
            CURRENT_VOLUME=$(pactl get-sink-volume @DEFAULT_SINK@ | awk '{print $5}' | head -n1)
            pactl set-sink-volume @DEFAULT_SINK@ "$CURRENT_VOLUME"
            tmux kill-server
            ;;
        *"i'm home"*|*"i'm back"*|*"im home"*|*"im back"*)
            log GREEN "Welcome back..."
            pactl set-sink-volume @DEFAULT_SINK@ 100%
            playerctl volume 0.8 -p spotify
            $SPEAK "welcome back!"
            playerctl next -p spotify
            adb -s "$TV_IP" shell input keyevent KEYCODE_WAKEUP
            timeout 5 ssh t-pirukas "sudo ddcutil setvcp 0xD6 1 2>/dev/null"
            timeout 5 catt -d "$TV_IP" volume 40
            node ~/scripts/tuya-control/remote.js bulb-1 on
            node ~/scripts/tuya-control/remote.js bulb-1 mode scene purplebulb
            node ~/scripts/tuya-control/remote.js bulb-2 on
            node ~/scripts/tuya-control/remote.js bulb-2 mode scene purplebulb
            node ~/scripts/tuya-control/remote.js led on
            node ~/scripts/tuya-control/remote.js led mode scene purpleled
            node ~/scripts/tuya-control/remote.js pluh-1 on
            CURRENT_VOLUME=$(pactl get-sink-volume @DEFAULT_SINK@ | awk '{print $5}' | head -n1)
            pactl set-sink-volume @DEFAULT_SINK@ "$CURRENT_VOLUME"
            tmux kill-server
            ;;
        *"project off"*|*"project of"*|*"projector off"*|*"projector of"*)
            log GREEN "Turing off projector..."; acknowledge &
            node ~/scripts/tuya-control/remote.js pluh-2 off
            node ~/scripts/tuya-control/remote.js pluh-2 on
            pactl set-sink-volume @DEFAULT_SINK@ "$CURRENT_VOLUME"
            LISTEN_MODE=0
            return 0
            ;;
        #"who"*|"what"*|"where"*|"when"*|"why"*|"how"*|"do"*|"does"*|"did"*|"is"*|"are"*|"am"*|"was"*|"were"*|"can"*|"could"*|"would"*|"will"*|"shall"*|"should"*|"has"*|"have"*|"had"*|"may"*|"might"*|"must"*)
        "question"*)
            log GREEN "Question received..."
            echo "AI thinking..."
            ai_answer=$(echo "answer with the least sentences possible: $cmd" | ai)
            log GREEN "$ai_answer"; $SPEAK "$ai_answer" &
            ;;
        *)
            log YELLOW "$cmd - Not a command."
#            log YELLOW "$cmd - Not a command."; confused
            ;;
    esac
}



# --- RUN SINGLE COMMAND IF PROVIDED ---
if [[ -n "$1" ]]; then
    LISTEN_MODE=1
    LAST_COMMAND_TIME=$(date +%s)
    CURRENT_VOLUME=$(pactl get-sink-volume @DEFAULT_SINK@ | awk '{print $5}' | head -n1)
    handle_command "$*"
    exit 0
fi



# --- MAIN LOOP ---
echo " 🤖 | Max:"
echo "───────────"
log NC "Max started."
while read -r line; do
    if [[ "$line" == HEARD:* ]]; then
        command="${line#HEARD: }"

        # --- WORD COUNTER ---
        words=$(cat ~/scripts/auth/ksk.theword)
        matches=0
        for w in $words; do
            count_for_word=$(grep -o -i "\b$w\b" <<< "$command" | wc -l)
            ((matches+=count_for_word))
        done
        if (( matches > 0 )); then
            ((count+=matches))
            log GREEN "MONKEYS: $count"; $SPEAK "$MONKEY_WORD" &
        fi

        handle_command "$command"
    fi
done < <(python3 -u ~/scripts/max/mic-listener.py 2>/dev/null)
